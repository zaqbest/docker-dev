# ============================================================
# Gitea 环境变量配置
# ============================================================

# ------------------------------------
# 服务器配置
# ------------------------------------
GITEA__server__DOMAIN=localhost
GITEA__server__HTTP_PORT=3000
GITEA__server__ROOT_URL=http://localhost:3000/
# SSH 对外显示给用户的域名和端口（clone 地址里显示的）
GITEA__server__SSH_DOMAIN=localhost
GITEA__server__SSH_PORT=2222
# Gitea 内置 SSH server 监听容器内的 2222（避开系统 sshd 占用的 22）
GITEA__server__SSH_LISTEN_PORT=2222
GITEA__server__START_SSH_SERVER=true
GITEA__server__DISABLE_SSH=false

# ------------------------------------
# 日志配置
# ------------------------------------
GITEA__log__MODE=console
GITEA__log__LEVEL=info

# ------------------------------------
# 注册与访问控制
# ------------------------------------
# 是否禁止自注册 (true=禁止，false=允许)
GITEA__service__DISABLE_REGISTRATION=false
# 是否需要登录才能查看
GITEA__service__REQUIRE_SIGNIN_VIEW=false
# 是否允许普通用户创建组织
GITEA__service__DEFAULT_ALLOW_CREATE_ORGANIZATION=true

# ------------------------------------
# Webhook 配置（允许回调本机服务）
# ------------------------------------
GITEA__webhook__ALLOWED_HOST_LIST=*

# ------------------------------------
# 缓存配置（内置内存缓存）
# ------------------------------------
GITEA__cache__ADAPTER=memory
GITEA__cache__INTERVAL=60

# ------------------------------------
# 会话配置
# ------------------------------------
GITEA__session__PROVIDER=memory

# ------------------------------------
# 队列配置
# ------------------------------------
GITEA__queue__TYPE=level
